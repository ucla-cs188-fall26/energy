# Copy to .env for local settings.
ENERGY_APP_NAME="Energy API"
ENERGY_DEBUG=false

# Only development exposes authenticated, read-only prediction previews.
# Set to development locally to enable Simulate Sleep; keep production in deployments.
ENERGY_ENVIRONMENT=production
# Optional product threshold (minutes); does not affect saved sessions or naps.
# ENERGY_PREDICTION__MIN_MAIN_SLEEP_MINUTES=30

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional
ENERGY_CORS_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081"]
